{
  "name": "template-react",
  "private": true,
  "version": "2.5.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:domain": "vite --host local.integrations.x-bees.com --port=443",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check src && tsc --noEmit",
    "lint:fix": "biome check --write src",
    "lint:diff": "bash ../tools/lint/lint-diff.sh",
    "lint:diff:fix": "bash ../tools/lint/lint-diff.sh --write",
    "version:patch": "pnpm version patch --no-git-tag-version",
    "version:minor": "pnpm version minor --no-git-tag-version",
    "version:prepatch": "pnpm version prepatch --no-git-tag-version",
    "version:preminor": "pnpm version preminor --no-git-tag-version",
    "version:pre": "pnpm version prerelease --no-git-tag-version"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/material": "^5.15.15",
    "@wildix/xbees-connect": "^1.3.6",
    "@wildix/xbees-connect-react": "1.2.43",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.6.0",
    "@wildix/eslint-config-style-guide": "^1.2.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-mkcert": "^1.17.5",
    "vitest": "^1.5.3"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "pnpm": ">=10.26.0 <11"
  }
}
